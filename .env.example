# =======================================================
# DeepSeek AI CryptoTrader - Configuration Template
# =======================================================

# 1. DeepSeek API Key (Required for AI Reasoning)
# Get your API key at: https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# 2. Trading Mode: 'paper' (simulated futures) or 'real' (Binance Futures)
TRADING_MODE=paper

# 3. Binance API (Optional - required only for REAL mode)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false

# 4. Telegram Notifications (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 5. Server Port
PORT=3000
